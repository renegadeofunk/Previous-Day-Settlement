//@version=5
indicator("Single Prev Day Settlement", overlay = true, max_bars_back = 5000)

max_bars_back(time, 5000)

// Daily close with lookahead gives the confirmed settlement at 4 pm CT / 5 pm ET
float closedSett = request.security(syminfo.tickerid, "D", close, lookahead = barmerge.lookahead_on)

// Detect the bar that straddles 4 pm CT (when the daily session closes for CME futures)
bool isLastSessionBar = hour(time, syminfo.timezone) < 16 and hour(time + timeframe.in_seconds() * 1000, syminfo.timezone) >= 16

var line settlementLine = na
var label settlementLabel = na

if isLastSessionBar
    int sessionCloseMs = time + timeframe.in_seconds() * 1000
    line.delete(settlementLine)
    settlementLine := line.new(
         x1     = sessionCloseMs,
         y1     = closedSett,
         x2     = sessionCloseMs + 1,
         y2     = closedSett,
         xloc   = xloc.bar_time,
         extend = extend.right,
         color  = #ff00ff,
         width  = 2)
    label.delete(settlementLabel)
    settlementLabel := label.new(
         x         = sessionCloseMs,
         y         = closedSett,
         text      = "Settlement",
         xloc      = xloc.bar_time,
         textcolor = #ff00ff,
         style     = label.style_label_right,
         color     = color.new(color.white, 100),
         size      = size.normal)
