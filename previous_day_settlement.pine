//@version=6
indicator("Single Prev Day Settlement", overlay = true, max_bars_back = 5000)

max_bars_back(time, 5000)

// close (with lookahead_on) reads the current daily bar's closing value.
// We only capture it when the session-close bar fires (4 pm CT / 5 pm ET),
// so there is no issue with using an in-progress value during the day.
float closedSett = request.security(syminfo.tickerid, "D", close, lookahead = barmerge.lookahead_on)

// CME session closes at 16:00 exchange time (4 pm CT = 5 pm ET).
// Fire on the first intraday bar that enters that hour.
// syminfo.timezone is "America/Chicago" for CME products.
bool isSessionClose = hour(time, syminfo.timezone) == 16 and
                      hour(time[1], syminfo.timezone) != 16

var int   settlementTime  = na
var float savedSettlement = na

if isSessionClose
    settlementTime  := time        // 4 pm CT / 5 pm ET bar timestamp
    savedSettlement := closedSett  // today's settlement, confirmed at session close

var line  settlementLine  = line.new(na, na, na, na, xloc = xloc.bar_time, color = #ff00ff, width = 2)
var label settlementLabel = na

if barstate.islast and not na(settlementTime)
    line.set_xy1(settlementLine, settlementTime, savedSettlement)
    line.set_xy2(settlementLine, time,           savedSettlement)
    label.delete(settlementLabel)
    settlementLabel := label.new(
         x         = time,
         y         = savedSettlement + syminfo.mintick,
         text      = "Settlement",
         xloc      = xloc.bar_time,
         textcolor = #ff00ff,
         style     = label.style_label_right,
         color     = color.new(color.white, 100),
         size      = size.normal
         )
