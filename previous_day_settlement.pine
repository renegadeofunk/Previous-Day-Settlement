//@version=6
indicator("Single Prev Day Settlement", overlay = true, max_bars_back = 5000)
// 1. Fetch previous daily settlement
pd_settlement = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
// 2. Identify the start of the display window.
// isNewDay fires on the first bar of the new session (6pm ET open).
// We step back one bar to the last bar of the closing session (~5pm ET),
// so the line spans the maintenance gap and is visible from market close.
max_bars_back(time, 5000)
isNewDay = ta.change(time("D")) != 0
var int dayStartIndex = na
if isNewDay
    dayStartIndex := math.max(0, bar_index - 1)
// 3. Create and Update the Line and Label
var line settlementLine = line.new(na, na, na, na, xloc = xloc.bar_index, color = #ff00ff, width = 2)
var label settlementLabel = na
if barstate.islast and not na(dayStartIndex)
    // Update Line: From the first bar of the day to the current bar
    line.set_xy1(settlementLine, dayStartIndex, pd_settlement)
    line.set_xy2(settlementLine, bar_index, pd_settlement)
    // Update Label
    label.delete(settlementLabel)
    float yPos = pd_settlement + (syminfo.mintick)

    settlementLabel := label.new(
         x = bar_index,
         y = yPos,
         text = "Settlement",
         xloc = xloc.bar_index,
         textcolor = #ff00ff,
         style = label.style_label_right,
         color = color.new(color.white, 100),
         size = size.normal
         )
